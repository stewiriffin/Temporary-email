<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.TempBox" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">?attr/accentColor</item>
        <item name="colorOnPrimary">@color/surface_dark_1</item>
        <item name="colorPrimaryVariant">?attr/accentColorDark</item>
        <item name="colorSecondary">?attr/accentColorDark</item>
        <item name="colorOnSecondary">@color/surface_dark_1</item>
        <item name="colorSurface">@color/surface_dark_2</item>
        <item name="colorOnSurface">@color/text_primary_dark</item>
        <item name="colorSurfaceVariant">@color/surface_dark_3</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary_dark</item>
        <item name="android:colorBackground">@color/surface_dark_1</item>
        <item name="android:windowBackground">@color/surface_dark_1</item>
        <item name="android:statusBarColor">@color/surface_dark_1</item>
        <item name="android:navigationBarColor">@color/surface_dark_1</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="colorOutline">@color/surface_dark_4</item>
        <item name="cardBackgroundColor">@color/surface_dark_2</item>
        <item name="android:windowAnimationStyle">@style/WindowAnimation.TempBox</item>
        <item name="rippleColor">?attr/accentColorMuted</item>

        <!-- Custom attributes -->
        <item name="accentColor">@color/accent_teal</item>
        <item name="accentColorDark">@color/accent_teal_dark</item>
        <item name="accentColorMuted">@color/accent_teal_muted</item>
    </style>

    <style name="Theme.TempBox.Dark" parent="Theme.TempBox" />
    <style name="Theme.TempBox.Light" parent="Theme.TempBox" />

    <style name="WindowAnimation.TempBox" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_in_left</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>
</resources>
